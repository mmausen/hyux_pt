#!/bin/sh
# Blocks commits that contain secrets or research data, even when they were added with `git add -f`.
# Turned on by `npm install` (package.json "prepare" sets core.hooksPath to .githooks).

blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)|(^|/)(logs|sessions)/|\.jsonl$|\.log$' | grep -vE '(^|/)\.env\.example$')
if [ -n "$blocked" ]; then
  echo "Commit blocked: these files must not be committed (secrets or research data):" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  echo "Remove them with: git restore --staged <file>" >&2
  exit 1
fi

# OpenAI-style API keys in any staged change.
if git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -qE 'sk-[A-Za-z0-9_-]{20,}'; then
  echo "Commit blocked: a staged change looks like it contains an API key (sk-…). Keep keys in .env only." >&2
  exit 1
fi
