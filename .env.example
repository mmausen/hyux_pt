# Copy this file to .env and fill in the values. .env is never committed.

# OpenAI API key. Stays on the server; never sent to the browser.
OPENAI_API_KEY=sk-your-key-here

# Port for the local server.
PORT=3000

# true enables the dev panel, dev routes and mock mode. Must be false (or absent) for participants.
DEV_MODE=false

# Set when running behind an HTTPS reverse proxy (e.g. Render, Fly, nginx) so rate limiting sees real client IPs.
# TRUST_PROXY=true
